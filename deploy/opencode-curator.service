[Unit]
Description=OpenCode subscription runtime for Omamail curator
After=default.target

[Service]
Type=simple
WorkingDirectory=%h
ExecStart=/bin/sh -c 'set -a; . "$HOME/.local/state/omamail-auth-trial/server.env"; set +a; exec "$HOME/.opencode/bin/opencode" serve --hostname 127.0.0.1 --port 4096'
Restart=on-failure
RestartSec=5
UMask=0077

[Install]
WantedBy=default.target
